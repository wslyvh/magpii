{
  "name": "magpii-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "model:fetch": "node scripts/fetch-rampart.mjs",
    "model:verify": "node scripts/fetch-rampart.mjs --verify",
    "runtime:prepare": "node scripts/copy-ort-assets.mjs",
    "build": "npm run model:verify && npm run runtime:prepare && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "libphonenumber-js": "1.13.13"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "jsdom": "^27.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
