{
  "name": "@intheopen/magpii",
  "version": "0.2.1",
  "description": "Local personal data detection and redaction, independent of the interface.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./model-lock.json": "./assets/model-lock.json",
    "./inference": {
      "types": "./dist/inference.d.ts",
      "default": "./dist/inference.js"
    },
    "./full-model-lock.json": "./assets/full-model-lock.json"
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "NOTICE.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "test:browser": "npm run build && playwright test",
    "model:fetch": "node scripts/fetch-model.mjs",
    "model:verify": "node scripts/fetch-model.mjs --verify",
    "model:export-full": "python3 scripts/export-full.py"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.13",
    "@huggingface/tokenizers": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vitest": "5.0.1",
    "esbuild": "^0.27.2",
    "@playwright/test": "1.63.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "bin": {
    "magpii-assets": "./bin/magpii-assets.mjs"
  }
}
