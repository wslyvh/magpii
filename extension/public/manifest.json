{
  "manifest_version": 3,
  "name": "Magpii",
  "description": "Magpii detects and masks personal information before you use sensitive text with ChatGPT, Claude, or other AI tools.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Magpii",
    "default_icon": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; worker-src 'self'"
  }
}
