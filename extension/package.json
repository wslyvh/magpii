{
  "name": "magpii-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "magpii-assets --out public/magpii && vite build",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package-extension.mjs",
    "store-screenshot": "node scripts/store-screenshot.mjs",
    "predev": "magpii-assets --out public/magpii"
  },
  "dependencies": {
    "@intheopen/magpii": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "0.3.0",
    "@types/node": "^22",
    "daisyui": "^5.7.43",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
